generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum SkillRequirement {
  REQUIRED
  PREFERRED
}

enum JobSourceType {
  PUBLIC_API
  CAREER_PAGE
  AGGREGATOR
  MANUAL_IMPORT
}

enum JobListingStatus {
  ACTIVE
  CLOSED
  EXPIRED
  UNKNOWN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
  UNKNOWN
}

enum RemotePreference {
  ANY
  REMOTE_ONLY
  ONSITE_OR_HYBRID
}

enum EligibilityStatus {
  ELIGIBLE
  INELIGIBLE
  UNCERTAIN
}

enum ReviewBatchStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum ReviewDecision {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum ApplicationStatus {
  REVIEW_PENDING
  APPROVED
  SUBMITTED
  INTERVIEW
  REJECTED
  WITHDRAWN
}

enum SyncStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum SyncTrigger {
  SCHEDULED
  MANUAL
}

model CandidateProfile {
  id              String           @id @default(cuid())
  fullName        String
  email           String           @unique
  phone           String?
  location        String?
  summary         String           @default("")
  skills          String[]         @default([])
  experience      Json
  projects        Json
  education       Json
  preferences     Json
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  uploadedResumes UploadedResume[]
  targetRoles     TargetRole[]
  applications    Application[]
  reviewBatches   ReviewBatch[]
}

model TargetRole {
  id                  String           @id @default(cuid())
  profileId           String
  name                String
  alternativeTitles   String[]         @default([])
  status              RoleStatus       @default(ACTIVE)
  locations           String[]         @default(["India"])
  remotePreference    RemotePreference @default(ANY)
  minExperienceMonths Int?
  maxExperienceMonths Int?
  minSalaryAnnual     Int?
  maxSalaryAnnual     Int?
  salaryCurrency      String           @default("INR")
  minFitScore         Int              @default(60)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  archivedAt          DateTime?

  profile      CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  skills       RoleSkill[]
  matches      JobMatch[]
  applications Application[]

  @@unique([profileId, name])
  @@index([profileId, status])
}

model RoleSkill {
  id              String           @id @default(cuid())
  roleId          String
  name            String
  requirementType SkillRequirement @default(REQUIRED)
  weight          Int              @default(1)

  role TargetRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, name])
  @@index([roleId, requirementType])
}

model JobSource {
  id          String        @id @default(cuid())
  name        String
  type        JobSourceType
  enabled     Boolean       @default(true)
  attribution String?
  config      Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  jobs     Job[]
  syncRuns SyncRun[]

  @@unique([name, type])
  @@index([enabled, type])
}

model Job {
  id                  String           @id @default(cuid())
  sourceId            String
  externalId          String?
  canonicalUrl        String           @unique
  title               String
  company             String
  location            String?
  description         String
  employmentType      EmploymentType   @default(UNKNOWN)
  remote              Boolean          @default(false)
  minExperienceMonths Int?
  maxExperienceMonths Int?
  minSalaryAnnual     Int?
  maxSalaryAnnual     Int?
  salaryCurrency      String           @default("INR")
  listingStatus       JobListingStatus @default(UNKNOWN)
  postedAt            DateTime?
  lastSeenAt          DateTime         @default(now())
  expiresAt           DateTime?
  contentHash         String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  source       JobSource     @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  matches      JobMatch[]
  applications Application[]

  @@unique([sourceId, externalId])
  @@index([listingStatus, createdAt])
  @@index([title, company])
  @@index([postedAt])
}

model JobMatch {
  id                    String            @id @default(cuid())
  jobId                 String
  roleId                String
  scoringVersion        Int               @default(1)
  score                 Int
  eligibility           EligibilityStatus @default(UNCERTAIN)
  meetsThreshold        Boolean           @default(false)
  matchedSkills         String[]          @default([])
  missingRequiredSkills String[]          @default([])
  reasons               Json
  evaluatedAt           DateTime          @default(now())
  createdAt             DateTime          @default(now())

  job        Job               @relation(fields: [jobId], references: [id], onDelete: Restrict)
  role       TargetRole        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  batchItems ReviewBatchItem[]

  @@unique([jobId, roleId, scoringVersion])
  @@index([roleId, score])
  @@index([roleId, meetsThreshold, evaluatedAt])
}

model ReviewBatch {
  id          String            @id @default(cuid())
  profileId   String
  status      ReviewBatchStatus @default(OPEN)
  createdAt   DateTime          @default(now())
  completedAt DateTime?

  profile CandidateProfile  @relation(fields: [profileId], references: [id], onDelete: Restrict)
  items   ReviewBatchItem[]

  @@index([profileId, status, createdAt])
}

model ReviewBatchItem {
  id            String         @id @default(cuid())
  batchId       String
  jobMatchId    String
  decision      ReviewDecision @default(PENDING)
  decidedAt     DateTime?
  notes         String?
  applicationId String?
  createdAt     DateTime       @default(now())

  batch       ReviewBatch  @relation(fields: [batchId], references: [id], onDelete: Restrict)
  jobMatch    JobMatch     @relation(fields: [jobMatchId], references: [id], onDelete: Restrict)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@unique([batchId, jobMatchId])
  @@index([batchId, decision])
}

model Application {
  id                    String            @id @default(cuid())
  profileId             String
  jobId                 String
  targetRoleId          String?
  status                ApplicationStatus @default(REVIEW_PENDING)
  fitScoreAtApplication Int
  fitReasons            Json
  notes                 String            @default("")
  approvedAt            DateTime?
  submittedAt           DateTime?
  externalReference     String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  profile     CandidateProfile  @relation(fields: [profileId], references: [id], onDelete: Restrict)
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Restrict)
  targetRole  TargetRole?       @relation(fields: [targetRoleId], references: [id], onDelete: SetNull)
  resumes     ResumeVersion[]
  reviewItems ReviewBatchItem[]

  @@unique([profileId, jobId])
  @@index([profileId, status, updatedAt])
  @@index([targetRoleId, status])
}

model ResumeVersion {
  id              String   @id @default(cuid())
  applicationId   String
  version         Int
  content         Json
  docxStorageKey  String?
  pdfStorageKey   String?
  contentHash     String?
  templateVersion String
  validation      Json?
  createdAt       DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@unique([applicationId, version])
  @@index([applicationId, createdAt])
}

model SyncRun {
  id           String      @id @default(cuid())
  sourceId     String?
  trigger      SyncTrigger
  status       SyncStatus  @default(RUNNING)
  startedAt    DateTime    @default(now())
  finishedAt   DateTime?
  jobsFound    Int         @default(0)
  jobsCreated  Int         @default(0)
  jobsUpdated  Int         @default(0)
  errorSummary String?
  stats        Json?

  source JobSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([status, startedAt])
  @@index([sourceId, startedAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  eventType  String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([eventType, createdAt])
}

enum TaskStatus {
  QUEUED
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  FAILED
  CANCELLED
}

model BackgroundTask {
  id     String     @id @default(cuid())
  type   String
  status TaskStatus @default(QUEUED)

  // Small JSON input for the worker; store large files separately.
  payload Json
  result  Json?

  // Retry and recovery state.
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?

  // Lifecycle timestamps.
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([status, runAt, createdAt])
  @@index([lockedAt])
  @@index([type, status, createdAt])
}

enum ResumeUploadStatus {
  READY
  FAILED
}

model UploadedResume {
  id            String             @id @default(cuid())
  profileId     String
  originalName  String
  mimeType      String             @default("application/pdf")
  sizeBytes     Int
  storageKey    String             @unique
  extractedText String             @db.Text
  status        ResumeUploadStatus @default(READY)
  errorMessage  String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@index([profileId, status])
}
